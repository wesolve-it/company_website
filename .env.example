# Generate a secret with: openssl rand -hex 32
PAYLOAD_SECRET=
SERVER_URL=http://localhost:3000
DATABASE_URL=file:./payload.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/wesolve
# Required on deployment: durable MEDIA_DIR (or add an object-storage adapter).
MEDIA_DIR=./media
# SMTP is optional locally; required for contact notifications / password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@wesolve-it.com
CONTACT_EMAIL=info@wesolve-it.com
# Optional newsletter integration; endpoint must implement DOI and unsubscribe.
NEWSLETTER_ENDPOINT=
NEWSLETTER_API_KEY=
# Tracking is disabled by default. Enable only after configuring consent/privacy.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
